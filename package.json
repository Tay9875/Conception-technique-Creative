{
  "name": "conception-technique-creative",
  "version": "1.0.0",
  "description": "Projet Conception technique & Creative",
  "private": true,
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"pnpm --filter server dev\" \"pnpm --filter client start\"",
    "start": "pnpm dev",
    "build": "pnpm --filter client build",
    "smoke:prod": "node scripts/smoke-prod.mjs",
    "lint": "pnpm --filter client lint && pnpm --filter server lint",
    "test": "pnpm --filter client exec react-scripts test --env=jsdom --watchAll=false --passWithNoTests",
    "db:up": "docker compose up -d --wait mysql",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f mysql",
    "db:migrate": "pnpm --filter server db:migrate",
    "db:seed": "pnpm --filter server db:seed",
    "db:prepare": "pnpm db:migrate && pnpm db:seed",
    "setup:local": "pnpm install && pnpm infra:up && pnpm db:prepare",
    "redis:up": "docker compose up -d --wait redis",
    "redis:down": "docker compose stop redis",
    "redis:logs": "docker compose logs -f redis",
    "infra:up": "docker compose up -d --wait db redis",
    "infra:down": "docker compose down"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}