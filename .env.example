# Local Docker defaults. Copy to .env only for local usage.
# Production Dokploy must not use host port mappings; use Domains -> web:8080.
WEB_PORT=8080
API_PORT=3000
MYSQL_PORT=3306

MYSQL_DATABASE=oncarya
MYSQL_USER=oncarya
MYSQL_PASSWORD=change-me-local
MYSQL_ROOT_PASSWORD=change-me-root-local

JWT_SECRET=change-me-local-only-32-characters-min
JWT_REFRESH_SECRET=change-me-refresh-local-32-characters-min
CORS_ORIGIN=http://localhost:8080,http://127.0.0.1:8080,http://localhost:3001
REACT_APP_API_URL=/api

MIGRATE_ON_START=true
SEED_ON_START=true
NODE_ENV=development
APP_VERSION=local
APP_COMMIT_SHA=local

# Production/Dokploy values are documented in docs/deployment-dokploy.md.
GHCR_IMAGE_NAME=ghcr.io/owner/repository/oncarya
APP_IMAGE_TAG=v1.0.0
