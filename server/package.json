{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "sh -c 'knex migrate:latest --knexfile knexfile.js --env development'",
    "db:seed": "tsx src/database/seed.ts",
    "db:purge-tokens": "tsx src/database/purge-refresh-tokens.ts",
    "test:integration": "RUN_INTEGRATION_TESTS=1 vitest run tests/integration.auth-posts.test.ts",
    "db:rollback": "sh -c 'knex migrate:rollback --knexfile knexfile.js --env development'",
    "db:migrate:status": "sh -c 'knex migrate:list --knexfile knexfile.js --env development'",
    "test:integration:all": "RUN_INTEGRATION_TESTS=1 vitest run tests/integration.*.test.ts"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.2.10",
    "mysql2": "^3.16.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "rate-limit-redis": "^5.0.0",
    "uuid": "^14.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/knex": "^0.15.2",
    "@types/node": "^25.8.0",
    "@types/supertest": "^7.2.0",
    "eslint": "^9.39.1",
    "supertest": "^7.2.2",
    "tsx": "^4.22.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  }
}
